<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 10.0.19041 (Windows 10 2004) brings in the WinRT APIs, for the media session (WindowsMediaSession.cs). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lets the Mac compile this project so Windows-only code is type-checked before deploying. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The launcher is a WinForms window hosting WebView2. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- For System.Windows.Automation, which follows focus into text fields (WindowsTextFocus.cs). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops these from the implicit usings (WPF has its own Path and so on). -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeTV.Core\HomeTV.Core.csproj" />
  </ItemGroup>

</Project>
