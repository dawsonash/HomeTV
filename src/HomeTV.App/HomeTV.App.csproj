<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0 runs on the Mac with fake platform services; net10.0-windows is what ships to the TV box. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HomeTV</AssemblyName>
  </PropertyGroup>

  <!-- No console window on the TV: the box build is a GUI-subsystem exe (it becomes the shell). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeTV.Core\HomeTV.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\HomeTV.Platform.Fake\HomeTV.Platform.Fake.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\HomeTV.Platform.Windows\HomeTV.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\apps.json" Link="apps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
